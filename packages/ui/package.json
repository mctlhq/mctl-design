{
  "name": "@mctlhq/ui",
  "version": "0.15.0",
  "description": "MCTL Vue 3 component library",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/mctl-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mctlhq/mctl-design.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && rollup -c rollup.types.config.mjs && tsc -p tsconfig.published.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test --max-warnings 0",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
