{
  "name": "@mctlhq/design",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "description": "MCTL shared design system \u2014 tokens, CSS, Vue 3 components and Storybook showcase",
  "license": "Apache-2.0",
  "homepage": "https://ui.mctl.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/mctlhq/mctl-design.git"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:versions": "node scripts/check-versions.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:token-version": "node scripts/check-token-version-bump.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:contrast:selftest": "node scripts/check-contrast.mjs --selftest",
    "check:themes": "node scripts/check-themes.mjs",
    "check:themes:selftest": "node scripts/check-themes.mjs --selftest",
    "check:generated": "node scripts/check-generated.mjs",
    "check:component-tokens": "node scripts/check-component-tokens.mjs",
    "check:component-tokens:selftest": "node scripts/check-component-tokens.mjs --selftest",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "@vitest/mocker@3": "^4.1.11",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "fast-uri@3": "^3.1.8",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "postcss@8": "^8.5.23",
      "ws@8": "^8.21.0"
    }
  }
}
