{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    // Never cached, and never given `outputs`: this task writes versioned CSS
    // into apps/storybook/public, outside its own package, which Turbo cannot
    // declare or restore. A cache replay would skip that write and leave
    // ci.yml's "generated CSS is committed" step passing having verified
    // nothing. See packages/css/scripts/build-css.mjs before editing this.
    //
    // A pkg#task entry REPLACES the generic `build` above rather than merging
    // with it, so `dependsOn` is repeated on purpose — a dependency added to
    // `build` later has to be added here too. `inputs` and `outputs` are left
    // out on purpose rather than forgotten: they only decide cache hits, and
    // this task never caches.
    "@mctlhq/css#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // The shared config lives at the repo root, outside each package, so
    // it has to be named or an edit to it replays a stale cached result.
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    // Every workspace tsconfig extends the root tsconfig.base.json.
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    // packages/ui's tests compile through tsconfig.json, which extends the
    // root base config.
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
